generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDING
  PROCESSING
  ASSIGNED
  IN_PROGRESS
  RESCUED
  CANCELLED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResourceType {
  BOAT
  AMBULANCE
  RESCUE_KIT
  FOOD_SUPPLY
  MEDICAL_KIT
  WATER_SUPPLY
  LIFE_JACKET
  BLANKET
  CLOTHING
  RESCUE_ROPE
  OXYGEN_CYLINDER
  BABY_SUPPLIES
  SANITARY_KIT
  FLASHLIGHT
  BATTERY
  FUEL
}

enum ResourceStatus {
  AVAILABLE
  DEPLOYED
  MAINTENANCE
}

enum TeamStatus {
  AVAILABLE
  DEPLOYED
  OFFLINE
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  passwordHash String
  phone        String?

  // Relationships
  requests RescueRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Operator {
  id            Int     @id @default(autoincrement())
  name          String
  email         String  @unique
  passwordHash  String
  contactNumber String?

  // Relationships
  deployments Deployment[] @relation("AssignedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RescueRequest {
  id Int @id @default(autoincrement())

  // Citizen-submitted information
  name           String
  pin            String
  latitude       Float
  longitude      Float
  emergencyType  String[]
  peopleAffected Int
  description    String

  // System-managed information
  status  RequestStatus @default(PENDING)
  urgency Urgency       @default(MEDIUM)

  // Foreign keys
  citizenId Int
  rescuerId Int?

  // Relationships
  citizen User     @relation(fields: [citizenId], references: [id])
  rescuer Rescuer? @relation("AssignedRescuer", fields: [rescuerId], references: [id])

  deployments Deployment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rescuer {
  id            Int        @id @default(autoincrement())
  name          String
  email         String     @unique
  passwordHash  String
  contactNumber String
  membersCount  Int
  latitude      Float?
  longitude     Float?
  status        TeamStatus @default(AVAILABLE)

  boatCapacity Int  @default(0)
  resources    Json @default("[]")

  // Relationships
  assignedRequests RescueRequest[] @relation("AssignedRescuer")
  deployments      Deployment[]

  createdAt DateTime @default(now())
}

model Resource {
  id        Int            @id @default(autoincrement())
  name      String
  type      ResourceType
  quantity  Int
  available Int
  status    ResourceStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
}

model Deployment {
  id Int @id @default(autoincrement())

  // Foreign keys
  requestId    Int
  rescuerId    Int
  assignedById Int?

  // Relationships
  request    RescueRequest @relation(fields: [requestId], references: [id])
  rescuer    Rescuer       @relation(fields: [rescuerId], references: [id])
  assignedBy Operator?     @relation("AssignedBy", fields: [assignedById], references: [id])

  // Resources consumed during this rescue
  resourcesUsed Json @default("[]")

  notes       String?
  deployedAt  DateTime  @default(now())
  completedAt DateTime?
}
